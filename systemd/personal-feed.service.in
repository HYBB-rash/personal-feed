[Unit]
Description=Personal Feed MCP service
After=network.target

[Service]
Type=simple
EnvironmentFile=@CONFIG_ENV@
ExecStart=@STORE_PATH@/bin/personal-feed serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@

[Install]
WantedBy=default.target
